# Example environment variables for LVN Sentinel
# Copy this file to `.env` and fill in the real values locally.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CAPITALE_INIZIALE=100000.0
INVESTIMENTO_PER_TRADE=10000.0
COMMISSIONE_APERTURA=10.0
COMMISSIONE_CHIUSURA=10.0

WINDOW_PROFILE=25
PRICE_TOLERANCE=0.05
LVN_THRESHOLD=0.50
BIN_STEP=0.05
MIN_PROFILE_LEVELS=5

DATA_DIR=data
DATABASE_DIR=database

REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_SLEEP_SECONDS=2

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=
